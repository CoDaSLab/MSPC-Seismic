{
  "paths": {
    "data": "data/involcan/mseed",
    "features": "data/involcan/features",
    "nocs": "data/involcan/nocs",
    "plots": "data/involcan/nocs/plots",
    "latest_pulls_log": "data/involcan/metadata/latest_pulls.csv",
    "noc_log": "data/involcan/metadata/noc_list.csv",
    "anomaly_log": "data/involcan/metadata/anomaly_log.csv",
    "station_catalog": "data/involcan/metadata/stations_all.dat"
  },
  "connection": {
    "ssh_key_path": "~/.ssh/id_ed25519",
    "ssh_key_passphrase": null,
    "server_IP": "server_IP",
    "server_user": "user",
    "mysql_connection": {
      "mysql_update": false,
      "user": "mysql_user",
      "password": "mysql_password",
      "database_name": "mysql_schema",
      "query": "update_query"
    }
  },
  "monitoring": {
    "auto_monitoring": true,
    "update_frequency": 5,
    "delay": 5,
    "num_days_before_delete": 10.0,
    "num_days_noc_update_frequency": 1.0,
    "num_days_noc_length": 4.0,
    "max_missing_rate": 0.1,
    "verbose": true,
    "criteria": {
      "type": "consecutive",
      "amount": 3
    },
    "plots": {
      "save": false,
      "num_hours": 1.0
    },
    "starttime": "auto",
    "endtime": "auto"
  },
  "features": {
    "window_size": 2,
    "window_shift": 2,
    "windowing": false,
    "detrend": "constant",
    "types": [
      "spectrogram_unfold"
    ],
    "merge_method": 1,
    "merge_fill_value": "interpolate",
    "pad_fill_value": 0,
    "stft_params": {
      "fft_points": "auto"
    },
    "noc_params": {
      "preprocessing": 1,
      "n_components": 1,
      "quantile_threshold": 0.99
    }
  },
  "groups": {
  },
  "metadata": {
    "running": false
  }
}
