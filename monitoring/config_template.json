{
  "paths": {
    "data": "data/involcan/mseed",
    "features": "data/involcan/features",
    "nocs": "data/involcan/nocs",
    "plots": "data/involcan/nocs/plots",
    "latest_pulls_log": "data/involcan/metadata/latest_pulls.csv",
    "noc_log": "data/involcan/metadata/noc_list.csv",
    "anomaly_log": "data/involcan/metadata/anomaly_log.csv"
  },
  "connection": {
    "ssh_key_path": "~/.ssh/id_rsa",
    "server_IP": "000.000.000.0",
    "server_user": "user"
  },
  "monitoring": {
    "auto_monitoring": true,
    "update_frequency": 5,
    "delay": 5,
    "num_days_before_delete": 30,
    "num_days_noc_update_frequency": 1,
    "num_days_noc_length": 7,
    "max_missing_rate": 0.1,
    "verbose": false,
    "criteria": {
      "type": "consecutive",
      "amount": 3
    },
    "plots": {
      "save": true,
      "num_hours": 1,
      "anomaly_criterion": "consecutive"
    }
  },
  "features": {
    "window_size": 10,
    "window_shift": null,
    "detrend": null,
    "windowing": false,
    "types": [
      "spectrogram_unfold"
    ],
    "merge_method": 1,
    "merge_fill_value": "interpolate",
    "pad_fill_value": 0,
    "stft_params": {
      "fft_points": "auto"
    }
  },
  "data": {
    "network": "C7",
    "stations": [
      "PSAB",
      "PLPI"
    ],
    "channels": [
      "HHE",
      "HHN",
      "HHZ"
    ],
    "starttime": "auto",
    "endtime": "auto"
  },
  "metadata": {
    "running": false
  }
}
